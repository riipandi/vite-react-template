{
    "$schema": "./node_modules/knip/schema-jsonc.json",
    "entry": ["app/routes.gen.ts"],
    "exclude": ["binaries", "dependencies"],
    "project": ["app/**/*.{ts,tsx}", "!app/components/**/*", "!app/**/*.d.ts"],
    "ignoreExportsUsedInFile": true,
    "tanstack-router": {
        "config": ["tsr.config.json"],
        "entry": ["app/routes.gen.{ts,js}"]
    },
    "paths": { "#/*": ["./app/*"] }
}
