{
    "name": "vite-react-template",
    "version": "0.0.0",
    "private": true,
    "homepage": "https://github.com/riipandi/vite-react-template",
    "bugs": {
        "url": "https://github.com/riipandi/vite-react-template/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/riipandi/vite-react-template.git"
    },
    "type": "module",
    "scripts": {
        "dev": "pnpm prebuild && vite",
        "start": "vite preview --host 0.0.0.0",
        "build": "pnpm prebuild && vite build && pnpm storybook:build",
        "storybook": "storybook dev -p 6006 --host 0.0.0.0 --no-open",
        "storybook:build": "storybook build -o .output/build/storybook",
        "storybook:start": "pnpm dlx node-http-server --root .output/build/storybook --host 0.0.0.0 --port 6006 --no-cache",
        "cleanup": "pnpm --silent cleanup:dist && pnpm --silent cleanup:deps",
        "cleanup:dist": "pnpm dlx del-cli dist storybook-static e2e-result app/routes.gen.ts",
        "cleanup:deps": "pnpm dlx del-cli .{output,tanstack,wrangler} pnpm-lock.yaml node_modules",
        "pre-commit": "lefthook run pre-commit --force",
        "prepare": "lefthook install || true",
        "prebuild": "tsr generate && tsc -b",
        "update-deps": "npm-check-updates --configFileName .ncurc.json",
        "knip": "knip -c .knip.jsonc --reporter markdown --no-exit-code",
        "e2e-install": "playwright install chromium --with-deps",
        "e2e-chrome": "playwright test --headed --project Chromium",
        "e2e-firefox": "playwright test --headed --project Firefox",
        "e2e-mobile": "playwright test --headed --project 'Mobile Chrome'",
        "e2e-safari": "playwright test --headed --project Safari",
        "e2e-report": "playwright show-report e2e-result",
        "e2e-ui": "playwright test --ui",
        "e2e": "playwright test",
        "test:report": "pnpm dlx node-http-server --root .output/tests-results --host 0.0.0.0 --port 8000 --spa --no-cache",
        "test:coverage": "vitest run --coverage --project unit",
        "test:ui": "vitest --ui",
        "test": "vitest --run --project unit",
        "test:storybook": "vitest run --project storybook",
        "check": "oxfmt --check && oxlint",
        "format": "oxfmt --write .",
        "lint": "oxlint --fix .",
        "typecheck": "tsc -b --noEmit"
    },
    "dependencies": {
        "@base-ui/react": "^1.8.0",
        "@blobatar/react": "^2.7.0",
        "@date-fns/tz": "^1.5.0",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@keyline-icons/react": "^1.7.0",
        "@stylexjs/atoms": "^0.19.1",
        "@stylexjs/stylex": "^0.19.1",
        "@tanstack/charts": "^1.0.0",
        "@tanstack/react-form": "^1.33.5",
        "@tanstack/react-hotkeys": "^0.13.0",
        "@tanstack/react-query": "^5.104.1",
        "@tanstack/react-router": "1.170.41",
        "@tanstack/react-store": "^0.11.2",
        "@tanstack/react-table": "^9.2.6",
        "@tanstack/react-virtual": "^3.14.13",
        "blobatar": "^2.7.0",
        "comlink": "^4.4.2",
        "country-flag-icons": "^1.6.20",
        "date-fns": "^4.4.0",
        "ofetch": "^1.5.1",
        "react": "^19.3.0",
        "react-day-picker": "^10.0.2",
        "react-dom": "^19.3.0",
        "react-phone-number-input": "^3.4.18",
        "react-resizable-panels": "^4.14.2",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@github-ui/storybook-addon-performance-panel": "^1.3.0",
        "@storybook/addon-a11y": "10.6.1",
        "@storybook/addon-docs": "10.6.1",
        "@storybook/addon-links": "10.6.1",
        "@storybook/addon-mcp": "^10.6.1",
        "@storybook/addon-vitest": "10.6.1",
        "@storybook/tanstack-react": "10.6.1",
        "@stylexjs/unplugin": "^0.19.1",
        "@tanstack/devtools-vite": "^0.8.5",
        "@tanstack/react-devtools": "^0.10.13",
        "@tanstack/react-query-devtools": "^5.104.1",
        "@tanstack/react-router-devtools": "^1.167.2",
        "@tanstack/router-cli": "^1.167.40",
        "@tanstack/router-plugin": "^1.168.42",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/browser-playwright": "^5.0.3",
        "@vitest/coverage-v8": "^5.0.3",
        "@vitest/ui": "^5.0.3",
        "happy-dom": "^20.14.5",
        "knip": "^6.39.0",
        "lefthook": "^2.1.17",
        "npm-check-updates": "^23.1.0",
        "oxc-transform-react": "^0.153.0",
        "oxfmt": "^0.72.0",
        "oxlint": "^1.87.0",
        "playwright": "^1.63.0",
        "remark-gfm": "^4.0.1",
        "storybook": "10.6.1",
        "typescript": "^7.0.2",
        "vite": "^8.3.2",
        "vitest": "^5.0.3",
        "vitest-browser-react": "^2.3.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.9.1",
            "onFail": "download"
        }
    },
    "engines": {
        "node": ">=24.21.0"
    }
}
