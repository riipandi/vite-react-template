{
    "name": "vite-react-template",
    "version": "0.5.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsr generate && tsc -b && vite build",
        "start": "pnpm dlx serve dist -l 3000 -s -n -C",
        "storybook": "storybook dev -p 6006 --no-open",
        "storybook:build": "storybook build -o .output/storybook",
        "storybook:start": "pnpm dlx serve .output/storybook -l 6006 -n -C",
        "cleanup": "pnpm dlx del-cli .{output,tanstack} app/routes.gen.ts dist node_modules",
        "pre-commit": "lefthook run pre-commit --force",
        "prepare": "lefthook install || true",
        "update-deps": "npm-check-updates --configFileName .ncurc.json",
        "knip": "knip -c .knip.jsonc --reporter markdown --no-exit-code",
        "test:report": "pnpm dlx serve .output/tests-results -l 8000 -s -n -C",
        "test:coverage": "vitest run --coverage --project unit",
        "test:ui": "vitest --ui",
        "test": "vitest --run --project unit",
        "test:storybook": "vitest run --project storybook",
        "format": "oxfmt --write .",
        "lint": "oxlint --fix .",
        "check": "oxfmt --check",
        "typecheck": "tsc -b --noEmit"
    },
    "dependencies": {
        "@base-ui/react": "^1.7.0",
        "@stylexjs/atoms": "^0.19.0",
        "@stylexjs/stylex": "^0.19.0",
        "@tanstack/react-form": "^1.33.5",
        "@tanstack/react-query": "^5.102.8",
        "@tanstack/react-router": "^1.170.32",
        "@tanstack/react-store": "^0.11.1",
        "css-variants": "^2.3.5",
        "obra-icons-react": "^1.24.0",
        "ofetch": "^1.5.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@github-ui/storybook-addon-performance-panel": "^1.2.0",
        "@storybook/addon-a11y": "^10.5.10",
        "@storybook/addon-docs": "^10.5.10",
        "@storybook/addon-links": "^10.5.10",
        "@storybook/addon-mcp": "^0.7.0",
        "@storybook/addon-vitest": "^10.5.10",
        "@storybook/react": "^10.5.10",
        "@storybook/react-vite": "^10.5.10",
        "@stylexjs/unplugin": "^0.19.0",
        "@tanstack/devtools-vite": "^0.8.5",
        "@tanstack/react-devtools": "^0.10.12",
        "@tanstack/react-query-devtools": "^5.102.8",
        "@tanstack/react-router-devtools": "^1.167.1",
        "@tanstack/router-cli": "^1.167.33",
        "@tanstack/router-plugin": "^1.168.35",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.4.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitest/browser-playwright": "^4.1.11",
        "@vitest/coverage-v8": "^4.1.11",
        "@vitest/ui": "^4.1.11",
        "happy-dom": "^20.13.1",
        "knip": "^6.34.0",
        "lefthook": "^2.1.12",
        "npm-check-updates": "^23.1.0",
        "oxfmt": "^0.66.0",
        "oxlint": "^1.81.0",
        "playwright": "^1.62.1",
        "remark-gfm": "^4.0.1",
        "storybook": "^10.5.10",
        "typescript": "7.0.2",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    },
    "packageManager": "pnpm@11.25.0"
}
